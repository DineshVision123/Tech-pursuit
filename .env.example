# Copy to .env.local and fill in to enable the contact form to actually send email.
# Without these set, the /api/contact route still validates input and returns a
# success response (per design), it just won't dispatch an email — safe no-op default.

# Resend (https://resend.com) — recommended, simplest path
RESEND_API_KEY=
# Verified sending address in your Resend domain, e.g. hello@techpursuitsystems.com
CONTACT_FROM_EMAIL=
# Inbox that should receive contact-form submissions
CONTACT_TO_EMAIL=

# Public site URL, used for metadata/OG tags and sitemap generation
NEXT_PUBLIC_SITE_URL=https://techpursuitsystems.com

# ---- Invoice portal (/portal/**) -----------------------------------------
# Its own standalone Neon Postgres — never shared with anything else this
# app talks to. Create a free project at https://neon.tech, copy its
# connection string here. Run `node --env-file=.env.local db/run-migrations.mjs`
# once to create the schema, then seed at least one allowed sign-in email
# with `node --env-file=.env.local db/seed-member.mjs you@company.com "Your Name" --can-delete`.
DATABASE_URL=

# Reuses the same RESEND_API_KEY above — just needs its own verified
# sending address, e.g. invoices@techpursuitsystems.com
INVOICE_FROM_EMAIL=

# Automatic payment reminders (see vercel.json's cron + api/portal/cron/reminders).
# Locks the cron endpoint down to Vercel's own scheduled requests — set any
# random long string here AND as the same env var in the Vercel project;
# Vercel then sends it automatically as "Authorization: Bearer <value>" on
# every cron-triggered request, and the route rejects anything else.
# Leave empty locally; the route just skips the check if it's unset.
CRON_SECRET=
# Days between one automatic follow-up and the next (the first fires as
# soon as an invoice is overdue). Defaults to 7 if unset.
REMINDER_INTERVAL_DAYS=7



