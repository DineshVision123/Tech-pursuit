# Copy to .env.local and fill in to enable the contact form to actually send email.
# Without these set, the /api/contact route still validates input and returns a
# success response (per design), it just won't dispatch an email — safe no-op default.

# Resend (https://resend.com) — recommended, simplest path
RESEND_API_KEY=
# Verified sending address in your Resend domain, e.g. hello@techpursuitsystems.com
CONTACT_FROM_EMAIL=
# Inbox that should receive contact-form submissions
CONTACT_TO_EMAIL=

# Public site URL, used for metadata/OG tags and sitemap generation
NEXT_PUBLIC_SITE_URL=https://techpursuitsystems.com



